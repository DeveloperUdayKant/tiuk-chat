# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public origin the browser uses (needed for CORS / cookies in production)
APP_ORIGIN=http://localhost:5173
# Sub-path the app is served from, e.g. /chat for https://thisisudaykant.com/chat (empty = domain root).
# Build the client with the same value:  BASE_PATH=/chat npm run build
BASE_PATH=

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string

# ── Database (MySQL 8) ───────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tiuk_chat

# ── Storage ──────────────────────────────────────────────
# Encrypted file blobs are stored here (server never sees plaintext)
UPLOAD_DIR=storage/uploads
MAX_FILE_MB=50
MAX_FILES_PER_MESSAGE=10
